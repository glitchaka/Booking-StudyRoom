@page "/"
@inject BookingService BookingService
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Agenda · Salas de estudio</PageTitle>

@if (!_ready)
{
    <div class="trello-loading">Cargando agenda…</div>
}
else
{
    <div class="trello-page">
        <header class="trello-topbar">
            <div class="trello-brand">
                <div class="trello-logo">B</div>
                <div class="trello-brand-copy">
                    <small>Biblioteca</small>
                    <strong>Salas de estudio</strong>
                </div>
            </div>

            <div class="trello-top-actions">
                <div class="board-search">
                    <span>⌕</span>
                    <input @bind="_boardSearch" @bind:event="oninput" placeholder="Filtrar reservas por nombre o RUT" />
                </div>
                <button class="board-toolbar-button" @onclick="OpenHistoryPanel">Historial</button>
                @if (Auth.CurrentUser?.IsAdmin == true)
                {
                    <button class="board-toolbar-button" @onclick="OpenStaffPanel">Funcionarios</button>
                }
                <div class="board-user">
                    <span class="board-avatar">@Initials(Auth.CurrentUser?.DisplayName)</span>
                    <div class="board-user-text">
                        <strong>@Auth.CurrentUser?.DisplayName</strong>
                        <small>@Auth.CurrentUser?.Username</small>
                    </div>
                </div>
                <button class="board-icon-button" title="Cerrar sesión" @onclick="Logout">↪</button>
            </div>
        </header>

        <section class="board-datebar">
            <div class="board-week-nav">
                <button class="board-icon-button" title="Semana anterior" @onclick="PreviousWeek">‹</button>
                <div class="board-week-copy">
                    <span class="board-eyebrow">Semana</span>
                    <strong>@WeekLabel()</strong>
                </div>
                <button class="board-icon-button" title="Semana siguiente" @onclick="NextWeek">›</button>
                <button class="board-today" @onclick="Today">Hoy</button>
            </div>

            <div class="board-days">
                @foreach (var day in WeekDays())
                {
                    <button class="board-day @(day.Date == _selectedDate.Date ? "active" : "")" @onclick="() => SelectDate(day)">
                        <span>@day.ToString("ddd", _culture).ToUpperInvariant()</span>
                        <strong>@day.Day</strong>
                    </button>
                }
            </div>

            <div class="board-kpis">
                <div class="board-view-chip">
                    <strong>@_bookings.Count</strong>
                    <small>Reservas</small>
                </div>
                <div class="board-view-chip">
                    <strong>@InUseNow()</strong>
                    <small>En uso</small>
                </div>
                <div class="board-view-chip">
                    <strong>@AvailableNow()</strong>
                    <small>Libres ahora</small>
                </div>
            </div>
        </section>

        <main class="board-main">
            <div class="board-heading">
                <div>
                    <span class="board-eyebrow">Tablero de salas</span>
                    <h1>@_selectedDate.ToString("dddd d 'de' MMMM", _culture)</h1>
                    <p>Cada lista es una sala. Las reservas son tarjetas ordenadas por horario; puedes arrastrarlas a otra sala.</p>
                </div>
                <div class="board-legend">
                    <span><i class="status-dot free"></i>Libre</span>
                    <span><i class="status-dot reserved"></i>Reservada</span>
                    <span><i class="status-dot active"></i>En uso</span>
                    <span><i class="status-dot incident"></i>Incidencia</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_boardMessage))
            {
                <div class="board-message">@_boardMessage</div>
            }

            <div class="trello-scroll">
                <div class="trello-board">
                    @foreach (var room in _rooms)
                    {
                        <section class="room-list"
                                 @ondragover:preventDefault="true"
                                 @ondrop="() => DropOnRoom(room)">
                            <header class="room-list-header">
                                <div class="room-title">
                                    <strong>@room.Name</strong>
                                    <small>@RoomReservationCount(room.Id) · @RoomOccupiedMinutes(room.Id) min reservados</small>
                                </div>
                                <span class="room-state @RoomStateClass(room)">@RoomStateText(room)</span>
                            </header>

                            <div class="room-list-body">
                                @if (!FilteredRoomBookings(room.Id).Any())
                                {
                                    <div class="room-empty">
                                        @if (string.IsNullOrWhiteSpace(_boardSearch))
                                        {
                                            <span>Sin reservas para este día</span>
                                        }
                                        else
                                        {
                                            <span>Sin coincidencias con el filtro</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    @foreach (var booking in FilteredRoomBookings(room.Id))
                                    {
                                        <article class="booking-card @BookingClass(booking)"
                                                 draggable="true"
                                                 @ondragstart="() => BeginDrag(booking)"
                                                 @ondragend="EndDrag"
                                                 @onclick="() => OpenBooking(booking)">
                                            <div class="booking-card-top">
                                                <span class="booking-time">@booking.StartAt.ToString("HH:mm")–@booking.EndAt.ToString("HH:mm")</span>
                                                <span class="booking-chip @BookingChipClass(booking)">@BookingShortStatus(booking)</span>
                                            </div>
                                            <strong class="booking-person">@booking.PatronName</strong>
                                            <small class="booking-rut">@BookingService.FormatRut(booking.Rut)</small>
                                            <div class="booking-card-footer">
                                                <span class="booking-marker @(booking.MarkerAndEraser ? "yes" : "")">✎ Plumón: @(booking.MarkerAndEraser ? "Sí" : "No")</span>
                                                @if (booking.IsIncident)
                                                {
                                                    <span>⚠ Incidencia</span>
                                                }
                                                else if (booking.IsDelivered)
                                                {
                                                    <span>✓ Entregada</span>
                                                }
                                                else
                                                {
                                                    <span>Arrastrar ↔</span>
                                                }
                                            </div>
                                        </article>
                                    }
                                }
                            </div>

                            <button class="room-add-button" @onclick="() => OpenNewBooking(room, SuggestedStart(room))">＋ Nueva reserva</button>
                        </section>
                    }

                    <button class="room-add-column" @onclick="AddRoom"><span>＋</span> Agregar sala</button>
                </div>
            </div>
        </main>
    </div>
}

@if (_showBookingForm)
{
    <div class="modal-backdrop" @onclick="CloseBookingForm">
        <section class="modal" @onclick:stopPropagation>
            <header class="modal-header">
                <div>
                    <span class="eyebrow">@(_editingBookingId is null ? "NUEVA RESERVA" : "EDITAR RESERVA")</span>
                    <h2>@_formRoom?.Name · @_selectedDate.ToString("dd/MM/yyyy")</h2>
                </div>
                <button class="icon-button" @onclick="CloseBookingForm">×</button>
            </header>

            <div class="form-grid two">
                <div>
                    <label>RUT</label>
                    <input class="large-input" @bind="_formRut" @onblur="CheckRut" placeholder="12.345.678-5" />
                </div>
                <div>
                    <label>Nombre</label>
                    <input class="large-input" @bind="_formName" placeholder="Nombre de la persona" />
                </div>
                <div>
                    <label>Hora de inicio</label>
                    <select value="@_formStartText" @onchange="StartChanged">
                        @foreach (var start in StartOptions())
                        {
                            <option value="@start.ToString("HH:mm")">@start.ToString("HH:mm")</option>
                        }
                    </select>
                </div>
                <div>
                    <label>Hora de término</label>
                    <select @bind="_formEndText">
                        @foreach (var end in EndOptions())
                        {
                            <option value="@end.ToString("HH:mm")">@end.ToString("HH:mm")</option>
                        }
                    </select>
                </div>
            </div>

            <p class="board-form-hint">El sistema impide superponer dos reservas en la misma sala.</p>

            <label class="toggle-row">
                <input type="checkbox" @bind="_formMarker" />
                <span>
                    <strong>Entrega plumón con borrador</strong>
                    <small>Quedará registrado junto a la reserva.</small>
                </span>
            </label>

            @if (_formPatronSummary is not null)
            {
                <div class="patron-alert @(_formPatronSummary.IsRepeatOffender ? "danger" : "")">
                    <div>
                        <strong>@(_formPatronSummary.IsRepeatOffender ? "Usuario reincidente" : "Usuario conocido")</strong>
                        <span>@_formPatronSummary.TotalUses usos · @_formPatronSummary.IncidentCount incidencias</span>
                    </div>
                    <button class="link-button" @onclick="() => OpenHistoryForRut(_formRut)">Ver historial</button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_formError))
            {
                <div class="form-error">@_formError</div>
            }

            <footer class="modal-footer">
                <button class="ghost-button" @onclick="CloseBookingForm">Cancelar</button>
                <button class="primary-button" @onclick="SaveBooking">@(_editingBookingId is null ? "Guardar reserva" : "Guardar cambios")</button>
            </footer>
        </section>
    </div>
}

@if (_selectedBooking is not null)
{
    <div class="drawer-backdrop" @onclick="CloseBookingDetail"></div>
    <aside class="drawer">
        <header class="drawer-header">
            <div>
                <span class="eyebrow">@_selectedBooking.Room?.Name</span>
                <h2>@_selectedBooking.PatronName</h2>
                <p>@BookingService.FormatRut(_selectedBooking.Rut)</p>
            </div>
            <button class="icon-button" @onclick="CloseBookingDetail">×</button>
        </header>

        <div class="detail-time">
            <div><span>Inicio</span><strong>@_selectedBooking.StartAt.ToString("HH:mm")</strong></div>
            <div class="time-arrow">→</div>
            <div><span>Término</span><strong>@_selectedBooking.EndAt.ToString("HH:mm")</strong></div>
        </div>

        <div class="detail-list">
            <div><span>Fecha</span><strong>@_selectedBooking.StartAt.ToString("dddd d MMM", _culture)</strong></div>
            <div><span>Plumón + borrador</span><strong>@(_selectedBooking.MarkerAndEraser ? "Sí" : "No")</strong></div>
            <div><span>Estado</span><strong>@BookingStatusText(_selectedBooking)</strong></div>
        </div>

        @if (_detailPatronSummary is not null)
        {
            <button class="history-summary @(_detailPatronSummary.IsRepeatOffender ? "danger" : "")" @onclick="() => OpenHistoryForRut(_selectedBooking.Rut)">
                <span>@(_detailPatronSummary.IsRepeatOffender ? "⚠" : "↺")</span>
                <div><strong>@_detailPatronSummary.TotalUses usos anteriores</strong><small>@_detailPatronSummary.IncidentCount incidencias registradas</small></div>
                <b>›</b>
            </button>
        }

        @if (_selectedBooking.IsDelivered)
        {
            <div class="return-note @(_selectedBooking.IsIncident ? "incident" : "")">
                <span class="eyebrow">ENTREGA REGISTRADA</span>
                <p>@(_selectedBooking.ReturnComment ?? "Sin comentario.")</p>
            </div>
        }
        else if (_showDeliverForm)
        {
            <div class="deliver-form">
                <label>Comentario al entregar</label>
                <textarea @bind="_returnComment" rows="4" placeholder="Opcional. Ej.: retraso, daños, discusión, sala ordenada…"></textarea>
                <label class="toggle-row compact">
                    <input type="checkbox" @bind="_returnIncident" />
                    <span><strong>Registrar como incidencia</strong><small>Quedará vinculada al RUT para futuras reservas.</small></span>
                </label>
                <div class="inline-actions">
                    <button class="ghost-button" @onclick="() => _showDeliverForm = false">Volver</button>
                    <button class="primary-button" @onclick="ConfirmDelivery">Confirmar entrega</button>
                </div>
            </div>
        }
        else
        {
            <div class="drawer-actions">
                <button class="primary-button full" @onclick="() => _showDeliverForm = true">Entregar sala</button>
                <button class="ghost-button full" @onclick="EditSelectedBooking">Editar reserva</button>
                <button class="danger-button full" @onclick="CancelSelectedBooking">Cancelar reserva</button>
            </div>
        }
    </aside>
}

@if (_showHistoryPanel)
{
    <div class="drawer-backdrop" @onclick="CloseHistoryPanel"></div>
    <aside class="drawer wide">
        <header class="drawer-header">
            <div>
                <span class="eyebrow">HISTORIAL POR RUT</span>
                <h2>@(_historySummary?.LastKnownName ?? "Buscar usuario")</h2>
                @if (_historySummary is not null)
                {
                    <p>@BookingService.FormatRut(_historySummary.Rut)</p>
                }
            </div>
            <button class="icon-button" @onclick="CloseHistoryPanel">×</button>
        </header>

        <div class="history-search-box">
            <input @bind="_historyRut" placeholder="RUT" @onkeydown="HistorySearchKey" />
            <button class="primary-button" @onclick="SearchHistory">Buscar</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_historyError))
        {
            <div class="form-error">@_historyError</div>
        }

        @if (_historySummary is not null)
        {
            <div class="history-kpis">
                <div><strong>@_historySummary.TotalUses</strong><span>Usos</span></div>
                <div class="@(_historySummary.IncidentCount > 0 ? "warn" : "")"><strong>@_historySummary.IncidentCount</strong><span>Incidencias</span></div>
                <div><strong>@(_historySummary.LastUse?.ToString("dd/MM/yy") ?? "—")</strong><span>Último uso</span></div>
            </div>

            @if (_historySummary.IsRepeatOffender)
            {
                <div class="repeat-warning"><strong>⚠ Usuario reincidente</strong><span>Mostrará una advertencia al crear nuevas reservas.</span></div>
            }

            <div class="history-list">
                @foreach (var item in _historyItems)
                {
                    <article class="history-item @(item.IsIncident ? "incident" : "")">
                        <div class="history-date"><strong>@item.StartAt.Day</strong><span>@item.StartAt.ToString("MMM", _culture)</span></div>
                        <div class="history-content">
                            <div><strong>@item.Room?.Name</strong><span>@item.StartAt.ToString("HH:mm")–@item.EndAt.ToString("HH:mm")</span></div>
                            <small>@(item.IsDelivered ? "Entregada" : "Sin entrega registrada") · Plumón: @(item.MarkerAndEraser ? "Sí" : "No")</small>
                            @if (!string.IsNullOrWhiteSpace(item.ReturnComment))
                            {
                                <p>@item.ReturnComment</p>
                            }
                        </div>
                        @if (item.IsIncident)
                        {
                            <span class="incident-badge">Incidencia</span>
                        }
                    </article>
                }
            </div>
        }
    </aside>
}

@if (_showStaffPanel)
{
    <div class="drawer-backdrop" @onclick="CloseStaffPanel"></div>
    <aside class="drawer wide">
        <header class="drawer-header">
            <div>
                <span class="eyebrow">ADMINISTRACIÓN</span>
                <h2>Funcionarios</h2>
                <p>Usuarios con acceso a la agenda</p>
            </div>
            <button class="icon-button" @onclick="CloseStaffPanel">×</button>
        </header>

        <div class="staff-create">
            <h3>Agregar funcionario</h3>
            <div class="form-grid two">
                <div><label>Nombre</label><input @bind="_staffName" /></div>
                <div><label>Usuario</label><input @bind="_staffUsername" /></div>
                <div><label>Contraseña</label><input type="password" @bind="_staffPassword" /></div>
                <label class="toggle-row compact"><input type="checkbox" @bind="_staffAdmin" /><span><strong>Administrador</strong><small>Puede administrar funcionarios.</small></span></label>
            </div>
            @if (!string.IsNullOrWhiteSpace(_staffError))
            {
                <div class="form-error">@_staffError</div>
            }
            <button class="primary-button" @onclick="CreateStaff">Guardar funcionario</button>
        </div>

        <div class="staff-list">
            @foreach (var staff in _staffUsers)
            {
                <article class="staff-row">
                    <span class="user-avatar">@Initials(staff.DisplayName)</span>
                    <div class="staff-info"><strong>@staff.DisplayName</strong><small>@@@staff.Username · @(staff.IsAdmin ? "Administrador" : "Funcionario")</small></div>
                    <span class="status-pill @(staff.IsActive ? "on" : "off")">@(staff.IsActive ? "Activo" : "Desactivado")</span>
                    <button class="ghost-button small" @onclick="() => ToggleStaff(staff)">@(staff.IsActive ? "Desactivar" : "Activar")</button>
                    <button class="ghost-button small" @onclick="() => BeginPasswordChange(staff)">Contraseña</button>
                </article>
            }
        </div>

        @if (_passwordUser is not null)
        {
            <div class="password-reset">
                <strong>Cambiar contraseña · @_passwordUser.DisplayName</strong>
                <input type="password" @bind="_newPassword" placeholder="Nueva contraseña" />
                <button class="primary-button" @onclick="SavePassword">Guardar</button>
                <button class="ghost-button" @onclick="CancelPasswordChange">Cancelar</button>
            </div>
        }
    </aside>
}

@code {
    private readonly CultureInfo _culture = CultureInfo.GetCultureInfo("es-CL");
    private const int DayStartHour = 8;
    private const int DayEndHour = 20;
    private const int SlotMinutes = 30;

    private bool _ready;
    private DateTime _selectedDate = DateTime.Today;
    private List<Room> _rooms = [];
    private List<Booking> _bookings = [];
    private string _boardSearch = "";
    private string? _boardMessage;
    private int? _draggedBookingId;

    private bool _showBookingForm;
    private int? _editingBookingId;
    private Room? _formRoom;
    private DateTime _formStart;
    private string _formStartText = "08:00";
    private string _formEndText = "09:00";
    private string _formRut = "";
    private string _formName = "";
    private bool _formMarker;
    private string? _formError;
    private PatronSummary? _formPatronSummary;

    private Booking? _selectedBooking;
    private PatronSummary? _detailPatronSummary;
    private bool _showDeliverForm;
    private string _returnComment = "";
    private bool _returnIncident;

    private bool _showHistoryPanel;
    private string _historyRut = "";
    private string? _historyError;
    private PatronSummary? _historySummary;
    private List<Booking> _historyItems = [];

    private bool _showStaffPanel;
    private List<StaffUser> _staffUsers = [];
    private string _staffName = "";
    private string _staffUsername = "";
    private string _staffPassword = "";
    private bool _staffAdmin;
    private string? _staffError;
    private StaffUser? _passwordUser;
    private string _newPassword = "";

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadDay();
        _ready = true;
    }

    private async Task LoadDay()
    {
        _rooms = await BookingService.GetRoomsAsync();
        _bookings = await BookingService.GetBookingsForDayAsync(_selectedDate);
    }

    private IEnumerable<DateTime> Slots()
    {
        var current = _selectedDate.Date.AddHours(DayStartHour);
        var end = _selectedDate.Date.AddHours(DayEndHour);
        while (current < end)
        {
            yield return current;
            current = current.AddMinutes(SlotMinutes);
        }
    }

    private IEnumerable<DateTime> StartOptions() => Slots();

    private IEnumerable<DateTime> EndOptions()
    {
        var current = _formStart.AddMinutes(SlotMinutes);
        var end = _formStart.Date.AddHours(DayEndHour);
        while (current <= end)
        {
            yield return current;
            current = current.AddMinutes(SlotMinutes);
        }
    }

    private IEnumerable<Booking> RoomBookings(int roomId)
        => _bookings.Where(x => x.RoomId == roomId).OrderBy(x => x.StartAt);

    private IEnumerable<Booking> FilteredRoomBookings(int roomId)
    {
        var bookings = RoomBookings(roomId);
        if (string.IsNullOrWhiteSpace(_boardSearch)) return bookings;

        var term = _boardSearch.Trim();
        var normalizedRut = BookingService.NormalizeRut(term);
        return bookings.Where(x =>
            x.PatronName.Contains(term, StringComparison.CurrentCultureIgnoreCase) ||
            BookingService.NormalizeRut(x.Rut).Contains(normalizedRut, StringComparison.OrdinalIgnoreCase));
    }

    private string RoomReservationCount(int roomId)
    {
        var count = RoomBookings(roomId).Count();
        return count == 1 ? "1 reserva" : $"{count} reservas";
    }

    private int RoomOccupiedMinutes(int roomId)
        => (int)RoomBookings(roomId).Sum(x => (x.EndAt - x.StartAt).TotalMinutes);

    private string BookingClass(Booking booking)
    {
        if (booking.IsIncident && booking.IsDelivered) return "incident";
        if (booking.IsDelivered) return "delivered";
        var now = DateTime.Now;
        if (booking.StartAt <= now && booking.EndAt > now) return "active";
        if (booking.EndAt <= now) return "overdue";
        return "reserved";
    }

    private string BookingChipClass(Booking booking)
    {
        if (booking.IsIncident) return "incident";
        if (!booking.IsDelivered && booking.StartAt <= DateTime.Now && booking.EndAt > DateTime.Now) return "active";
        return "";
    }

    private string BookingShortStatus(Booking booking)
    {
        if (booking.IsDelivered) return booking.IsIncident ? "Incidencia" : "Entregada";
        if (booking.StartAt <= DateTime.Now && booking.EndAt > DateTime.Now) return "En uso";
        if (booking.EndAt <= DateTime.Now) return "Pendiente";
        return "Reservada";
    }

    private string BookingStatusText(Booking booking)
    {
        if (booking.IsDelivered) return booking.IsIncident ? "Entregada con incidencia" : "Entregada";
        if (booking.StartAt <= DateTime.Now && booking.EndAt > DateTime.Now) return "En uso";
        if (booking.EndAt <= DateTime.Now) return "Entrega pendiente";
        return "Reservada";
    }

    private string RoomStateText(Room room)
    {
        var roomBookings = RoomBookings(room.Id).ToList();
        if (_selectedDate.Date != DateTime.Today)
        {
            if (roomBookings.Count == 0) return "Libre";
            return roomBookings.Count == 1 ? "1 reserva" : $"{roomBookings.Count} reservas";
        }

        var now = DateTime.Now;
        var current = roomBookings.FirstOrDefault(x => !x.IsDelivered && x.StartAt <= now && x.EndAt > now);
        if (current is not null) return "En uso";
        var next = roomBookings.FirstOrDefault(x => !x.IsDelivered && x.StartAt > now);
        if (next is not null) return $"Próxima {next.StartAt:HH:mm}";
        return "Libre";
    }

    private string RoomStateClass(Room room)
    {
        var text = RoomStateText(room);
        if (text == "En uso") return "active";
        if (text.StartsWith("Próxima") || text.Contains("reserva")) return "next";
        return "free";
    }

    private int InUseNow()
    {
        if (_selectedDate.Date != DateTime.Today) return 0;
        var now = DateTime.Now;
        return _bookings.Count(x => !x.IsDelivered && x.StartAt <= now && x.EndAt > now);
    }

    private int AvailableNow() => _selectedDate.Date == DateTime.Today ? Math.Max(0, _rooms.Count - InUseNow()) : _rooms.Count;

    private DateTime WeekStart()
    {
        var offset = ((int)_selectedDate.DayOfWeek + 6) % 7;
        return _selectedDate.Date.AddDays(-offset);
    }

    private IEnumerable<DateTime> WeekDays()
    {
        var start = WeekStart();
        for (var i = 0; i < 6; i++) yield return start.AddDays(i);
    }

    private string WeekLabel()
    {
        var start = WeekStart();
        var end = start.AddDays(5);
        return start.Month == end.Month
            ? $"{start:dd}–{end:dd} {end.ToString("MMM", _culture)}"
            : $"{start:dd MMM}–{end:dd MMM}";
    }

    private async Task SelectDate(DateTime day)
    {
        _selectedDate = day.Date;
        _boardMessage = null;
        await LoadDay();
    }

    private async Task PreviousWeek() => await SelectDate(_selectedDate.AddDays(-7));
    private async Task NextWeek() => await SelectDate(_selectedDate.AddDays(7));
    private async Task Today() => await SelectDate(DateTime.Today);

    private async Task AddRoom()
    {
        var room = await BookingService.AddRoomAsync();
        _rooms = await BookingService.GetRoomsAsync();
        _boardMessage = $"{room.Name} agregada al tablero.";
    }

    private DateTime SuggestedStart(Room room)
    {
        var dayStart = _selectedDate.Date.AddHours(DayStartHour);
        var lastStart = _selectedDate.Date.AddHours(DayEndHour).AddMinutes(-SlotMinutes);
        var candidate = dayStart;

        if (_selectedDate.Date == DateTime.Today && DateTime.Now > dayStart)
        {
            var now = DateTime.Now;
            var minutes = (int)Math.Ceiling(now.Minute / (double)SlotMinutes) * SlotMinutes;
            candidate = new DateTime(now.Year, now.Month, now.Day, now.Hour, 0, 0).AddMinutes(minutes);
            if (candidate < dayStart) candidate = dayStart;
        }

        while (candidate <= lastStart)
        {
            var end = candidate.AddHours(1);
            if (end > _selectedDate.Date.AddHours(DayEndHour)) end = candidate.AddMinutes(SlotMinutes);
            var overlaps = RoomBookings(room.Id).Any(x => candidate < x.EndAt && end > x.StartAt);
            if (!overlaps) return candidate;
            candidate = candidate.AddMinutes(SlotMinutes);
        }

        return lastStart;
    }

    private void OpenNewBooking(Room room, DateTime start)
    {
        _editingBookingId = null;
        _formRoom = room;
        _formStart = start;
        _formStartText = start.ToString("HH:mm");
        _formEndText = start.AddHours(1) <= start.Date.AddHours(DayEndHour)
            ? start.AddHours(1).ToString("HH:mm")
            : start.AddMinutes(SlotMinutes).ToString("HH:mm");
        _formRut = "";
        _formName = "";
        _formMarker = false;
        _formError = null;
        _formPatronSummary = null;
        _showBookingForm = true;
    }

    private void StartChanged(ChangeEventArgs args)
    {
        _formStartText = args.Value?.ToString() ?? "08:00";
        if (!TimeSpan.TryParse(_formStartText, out var startTime)) return;

        _formStart = _selectedDate.Date.Add(startTime);
        var preferredEnd = _formStart.AddHours(1);
        var dayEnd = _selectedDate.Date.AddHours(DayEndHour);
        if (preferredEnd > dayEnd) preferredEnd = _formStart.AddMinutes(SlotMinutes);
        _formEndText = preferredEnd.ToString("HH:mm");
    }

    private void CloseBookingForm()
    {
        _showBookingForm = false;
        _editingBookingId = null;
    }

    private async Task CheckRut()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_formRut)) return;
        if (!BookingService.IsValidChileanRut(_formRut))
        {
            _formPatronSummary = null;
            _formError = "El RUT ingresado no es válido.";
            return;
        }

        _formPatronSummary = await BookingService.GetPatronSummaryAsync(_formRut);
        if (_formPatronSummary is not null && string.IsNullOrWhiteSpace(_formName))
            _formName = _formPatronSummary.LastKnownName;
    }

    private async Task SaveBooking()
    {
        if (_formRoom is null) return;
        if (!TimeSpan.TryParse(_formStartText, out var startTime) || !TimeSpan.TryParse(_formEndText, out var endTime))
        {
            _formError = "Selecciona un horario válido.";
            return;
        }

        var start = _selectedDate.Date.Add(startTime);
        var end = _selectedDate.Date.Add(endTime);

        if (_editingBookingId is null)
        {
            var result = await BookingService.CreateBookingAsync(
                _formRoom.Id, start, end, _formRut, _formName, _formMarker, Auth.CurrentUser?.Id);
            if (!result.Ok)
            {
                _formError = result.Error;
                return;
            }
            _boardMessage = $"Reserva guardada en {_formRoom.Name}.";
        }
        else
        {
            var result = await BookingService.UpdateBookingAsync(
                _editingBookingId.Value, _formRoom.Id, start, end, _formRut, _formName, _formMarker);
            if (!result.Ok)
            {
                _formError = result.Error;
                return;
            }
            _boardMessage = "Reserva actualizada.";
        }

        CloseBookingForm();
        await LoadDay();
    }

    private void BeginDrag(Booking booking)
    {
        _draggedBookingId = booking.Id;
        _boardMessage = $"Moviendo reserva de {booking.PatronName}. Suelta la tarjeta sobre otra sala.";
    }

    private void EndDrag()
    {
        _draggedBookingId = null;
    }

    private async Task DropOnRoom(Room room)
    {
        if (_draggedBookingId is null) return;
        var booking = _bookings.FirstOrDefault(x => x.Id == _draggedBookingId.Value);
        _draggedBookingId = null;
        if (booking is null || booking.RoomId == room.Id) return;

        var result = await BookingService.UpdateBookingAsync(
            booking.Id,
            room.Id,
            booking.StartAt,
            booking.EndAt,
            booking.Rut,
            booking.PatronName,
            booking.MarkerAndEraser);

        if (!result.Ok)
        {
            _boardMessage = $"No se pudo mover la reserva a {room.Name}: {result.Error}";
            return;
        }

        _boardMessage = $"Reserva movida a {room.Name}.";
        await LoadDay();
    }

    private async Task OpenBooking(Booking booking)
    {
        _selectedBooking = booking;
        _showDeliverForm = false;
        _returnComment = "";
        _returnIncident = false;
        _detailPatronSummary = await BookingService.GetPatronSummaryAsync(booking.Rut);
    }

    private void CloseBookingDetail()
    {
        _selectedBooking = null;
        _showDeliverForm = false;
    }

    private void EditSelectedBooking()
    {
        if (_selectedBooking is null) return;
        var room = _rooms.FirstOrDefault(x => x.Id == _selectedBooking.RoomId);
        if (room is null) return;

        _editingBookingId = _selectedBooking.Id;
        _formRoom = room;
        _formStart = _selectedBooking.StartAt;
        _formStartText = _selectedBooking.StartAt.ToString("HH:mm");
        _formEndText = _selectedBooking.EndAt.ToString("HH:mm");
        _formRut = BookingService.FormatRut(_selectedBooking.Rut);
        _formName = _selectedBooking.PatronName;
        _formMarker = _selectedBooking.MarkerAndEraser;
        _formPatronSummary = _detailPatronSummary;
        _formError = null;
        CloseBookingDetail();
        _showBookingForm = true;
    }

    private async Task ConfirmDelivery()
    {
        if (_selectedBooking is null) return;
        var id = _selectedBooking.Id;
        await BookingService.DeliverAsync(id, _returnComment, _returnIncident);
        CloseBookingDetail();
        _boardMessage = _returnIncident ? "Entrega registrada con incidencia." : "Entrega registrada.";
        await LoadDay();
    }

    private async Task CancelSelectedBooking()
    {
        if (_selectedBooking is null) return;
        await BookingService.CancelAsync(_selectedBooking.Id);
        CloseBookingDetail();
        _boardMessage = "Reserva cancelada.";
        await LoadDay();
    }

    private void OpenHistoryPanel()
    {
        _historyError = null;
        _showHistoryPanel = true;
    }

    private async Task OpenHistoryFromSearch()
    {
        _showHistoryPanel = true;
        await SearchHistory();
    }

    private async Task OpenHistoryForRut(string rut)
    {
        _historyRut = BookingService.FormatRut(rut);
        _showHistoryPanel = true;
        await SearchHistory();
    }

    private async Task HistorySearchKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await OpenHistoryFromSearch();
    }

    private async Task SearchHistory()
    {
        _historyError = null;
        _historySummary = null;
        _historyItems = [];

        if (!BookingService.IsValidChileanRut(_historyRut))
        {
            _historyError = "Ingresa un RUT válido.";
            return;
        }

        _historySummary = await BookingService.GetPatronSummaryAsync(_historyRut);
        if (_historySummary is null)
        {
            _historyError = "No hay registros para este RUT.";
            return;
        }

        _historyItems = await BookingService.GetPatronHistoryAsync(_historyRut);
    }

    private void CloseHistoryPanel() => _showHistoryPanel = false;

    private async Task OpenStaffPanel()
    {
        _staffError = null;
        _staffUsers = await Auth.GetUsersAsync();
        _showStaffPanel = true;
    }

    private void CloseStaffPanel()
    {
        _showStaffPanel = false;
        CancelPasswordChange();
    }

    private async Task CreateStaff()
    {
        _staffError = null;
        var result = await Auth.CreateUserAsync(_staffName, _staffUsername, _staffPassword, _staffAdmin);
        if (!result.Ok)
        {
            _staffError = result.Error;
            return;
        }

        _staffName = "";
        _staffUsername = "";
        _staffPassword = "";
        _staffAdmin = false;
        _staffUsers = await Auth.GetUsersAsync();
    }

    private async Task ToggleStaff(StaffUser staff)
    {
        if (staff.Id == Auth.CurrentUser?.Id && staff.IsActive)
        {
            _staffError = "No puedes desactivar tu propia cuenta mientras la estás usando.";
            return;
        }
        await Auth.SetActiveAsync(staff.Id, !staff.IsActive);
        _staffUsers = await Auth.GetUsersAsync();
    }

    private void BeginPasswordChange(StaffUser staff)
    {
        _passwordUser = staff;
        _newPassword = "";
        _staffError = null;
    }

    private void CancelPasswordChange()
    {
        _passwordUser = null;
        _newPassword = "";
    }

    private async Task SavePassword()
    {
        if (_passwordUser is null) return;
        var result = await Auth.ChangePasswordAsync(_passwordUser.Id, _newPassword);
        if (!result.Ok)
        {
            _staffError = result.Error;
            return;
        }
        CancelPasswordChange();
    }

    private void Logout()
    {
        Auth.Logout();
        Navigation.NavigateTo("/login");
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0])));
    }
}
