@page "/personal"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@inject UserManager<StaffUser> UserManager
<PageTitle>Personal</PageTitle>
<section class="simple-page"><div class="page-heading"><div><span>CONFIGURACIÓN</span><h1>Personal autorizado</h1></div><button class="primary" @onclick="()=>showForm=true">+ Agregar usuario</button></div><div class="staff-list">@foreach(var u in users){<div class="staff-row"><div class="avatar">@Initials(u.DisplayName)</div><div><strong>@u.DisplayName</strong><span>@u.UserName</span></div><span class="status @(u.IsActive?"active":"inactive")">@(u.IsActive?"Activo":"Inactivo")</span><button class="ghost" @onclick="()=>Toggle(u)">@(u.IsActive?"Desactivar":"Activar")</button></div>}</div></section>
@if(showForm){<div class="modal-backdrop" @onclick="()=>showForm=false"><div class="modal-card small" @onclick:stopPropagation><div class="modal-head"><div><span>Nuevo acceso</span><h2>Agregar personal</h2></div><button class="close" @onclick="()=>showForm=false">×</button></div>@if(!string.IsNullOrWhiteSpace(error)){<div class="alert danger">@error</div>}<div class="form-stack"><label>Nombre<input @bind="name" /></label><label>Usuario<input @bind="username" /></label><label>Contraseña<input type="password" @bind="password" /></label></div><div class="modal-actions"><button class="ghost" @onclick="()=>showForm=false">Cancelar</button><button class="primary" @onclick="Create">Guardar</button></div></div></div>}
@code{List<StaffUser> users=[];bool showForm;string name="",username="",password="",error="";protected override void OnInitialized()=>users=UserManager.Users.OrderBy(x=>x.DisplayName).ToList();async Task Create(){error="";var u=new StaffUser{DisplayName=name.Trim(),UserName=username.Trim(),IsActive=true};var r=await UserManager.CreateAsync(u,password);if(!r.Succeeded){error=string.Join(" ",r.Errors.Select(e=>e.Description));return;}users=UserManager.Users.OrderBy(x=>x.DisplayName).ToList();showForm=false;name=username=password="";}async Task Toggle(StaffUser u){u.IsActive=!u.IsActive;await UserManager.UpdateAsync(u);users=UserManager.Users.OrderBy(x=>x.DisplayName).ToList();}static string Initials(string s)=>string.Concat(s.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>char.ToUpperInvariant(x[0])));}
